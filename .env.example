# Claim notifications — configure at least one channel in Vercel project env vars.

# Email via Resend (https://resend.com)
RESEND_API_KEY=
CLAIM_NOTIFY_TO=you@example.com
# Optional verified sender. Defaults to Resend onboarding address.
# CLAIM_NOTIFY_FROM=Zusammen Frey <notify@yourdomain.com>

# Optional Discord / Slack / generic webhook (sent as JSON { content, text })
# CLAIM_WEBHOOK_URL=
